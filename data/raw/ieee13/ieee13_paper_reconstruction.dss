! ieee13_paper_reconstruction.dss
!
! Modified IEEE 13-node feeder per Jang, Kim & Kim (2023), built directly on
! top of the official IEEE13Nodeckt.dss topology/line/load data in this same
! directory (IEEE13Nodeckt_official.dss). This file is the OpenDSS-side
! twin of experiments/exp02_13bus.py's build_13bus_system() -- every
! modification and reconstruction assumption documented in that module's
! docstring applies identically here, so the two can be cross-validated.
! Do not edit one without re-checking the other.
!
! Differences from the official file:
!   1. Distributed-load stand-in (Load.670a/670b/670c) removed.
!   2. Both capacitor banks removed.
!   3. T1 ("Sub"): Yg(SourceBus)-Delta(650), R=8%, X=10% (paper's own
!      values, NOT the official file's near-zero placeholder or Delta-Wye
!      connection).
!   4. T2 ("XFM1"): Delta(633)-Delta(634), R=2%, X=1.1% on ITS OWN 500 kVA
!      base (matching the paper's per-unit table directly -- OpenDSS
!      transformer %R/XHL are already expressed on the transformer's own
!      kVA base, so no rescaling is needed here, unlike the Python model's
!      explicit rescale onto a shared 5 MVA system base).
!   5. Voltage regulators (Reg1/2/3) and the closed 671-692 switch are
!      omitted; bus RG60 is replaced by 650 and bus 692 is replaced by 671
!      throughout (ideal-merge simplification -- see exp02_13bus.py
!      assumption D).
!
! %R is split evenly across both windings (matching the official file's own
! XFM1 %r=.55/.55 convention for its total 1.1%), so total R = 2*%r.

Clear
Set DefaultBaseFrequency=60

new circuit.IEEE13_Paper_Reconstruction
~ basekv=115 pu=1.0 phases=3 bus1=SourceBus
~ MVAsc3=20000 MVASC1=21000

! T1 ("Sub"): paper R=0.08 pu (8%), X=0.10 pu (10%), Yg-Delta.
New Transformer.T1 Phases=3 Windings=2 XHL=10
~ wdg=1 bus=SourceBus conn=wye   kv=115   kva=5000 %r=4
~ wdg=2 bus=650       conn=delta kv=4.16  kva=5000 %r=4

! T2 ("XFM1"): paper R=0.02 pu (2%), X=0.011 pu (1.1%), Delta-Delta.
New Transformer.T2 Phases=3 Windings=2 XHL=1.1
~ wdg=1 bus=633 conn=delta kv=4.16  kva=500 %r=1
~ wdg=2 bus=634 conn=delta kv=0.48  kva=500 %r=1

! Local matrix line codes, identical to the official file (corrected mtx606).
New linecode.mtx601 nphases=3 BaseFreq=60
~ rmatrix = (0.3465 | 0.1560 0.3375 | 0.1580 0.1535 0.3414 )
~ xmatrix = (1.0179 | 0.5017 1.0478 | 0.4236 0.3849 1.0348 )
~ units=mi
New linecode.mtx602 nphases=3 BaseFreq=60
~ rmatrix = (0.7526 | 0.1580 0.7475 | 0.1560 0.1535 0.7436 )
~ xmatrix = (1.1814 | 0.4236 1.1983 | 0.5017 0.3849 1.2112 )
~ units=mi
New linecode.mtx603 nphases=2 BaseFreq=60
~ rmatrix = (1.3238 | 0.2066 1.3294 )
~ xmatrix = (1.3569 | 0.4591 1.3471 )
~ units=mi
New linecode.mtx604 nphases=2 BaseFreq=60
~ rmatrix = (1.3238 | 0.2066 1.3294 )
~ xmatrix = (1.3569 | 0.4591 1.3471 )
~ units=mi
New linecode.mtx605 nphases=1 BaseFreq=60
~ rmatrix = (1.3292 )
~ xmatrix = (1.3475 )
~ units=mi
New Linecode.mtx606 nphases=3  Units=mi
~ Rmatrix=[0.791721  |0.318476  0.791721  |0.28345  0.318476  0.791721  ]
~ Xmatrix=[0.438352  |0.0276838  0.438352  |-0.0184204  0.0276838  0.438352  ]
New linecode.mtx607 nphases=1 BaseFreq=60
~ rmatrix = (1.3425 )
~ xmatrix = (0.5124 )
~ units=mi

! LOAD DEFINITIONS (Load.670a/670b/670c and both capacitors omitted).
New Load.671  Bus1=671.1.2.3  Phases=3 Conn=Delta Model=1 kV=4.16   kW=1155 kvar=660
New Load.634a Bus1=634.1      Phases=1 Conn=Wye   Model=1 kV=0.277  kW=160  kvar=110
New Load.634b Bus1=634.2      Phases=1 Conn=Wye   Model=1 kV=0.277  kW=120  kvar=90
New Load.634c Bus1=634.3      Phases=1 Conn=Wye   Model=1 kV=0.277  kW=120  kvar=90
New Load.645  Bus1=645.2      Phases=1 Conn=Wye   Model=1 kV=2.4    kW=170  kvar=125
New Load.646  Bus1=646.2.3    Phases=1 Conn=Delta Model=1 kV=4.16   kW=230  kvar=132
New Load.692  Bus1=671.3.1    Phases=1 Conn=Delta Model=1 kV=4.16   kW=170  kvar=151
New Load.675a Bus1=675.1      Phases=1 Conn=Wye   Model=1 kV=2.4    kW=485  kvar=190
New Load.675b Bus1=675.2      Phases=1 Conn=Wye   Model=1 kV=2.4    kW=68   kvar=60
New Load.675c Bus1=675.3      Phases=1 Conn=Wye   Model=1 kV=2.4    kW=290  kvar=212
New Load.611  Bus1=611.3      Phases=1 Conn=Wye   Model=1 kV=2.4    kW=170  kvar=80
New Load.652  Bus1=652.1      Phases=1 Conn=Wye   Model=1 kV=2.4    kW=128  kvar=86

! LINE DEFINITIONS (RG60 -> 650, 692 -> 671, matching exp02_13bus.py's merge).
New Line.650632 Phases=3 Bus1=650.1.2.3 Bus2=632.1.2.3 LineCode=mtx601 Length=2000 units=ft
New Line.632670 Phases=3 Bus1=632.1.2.3 Bus2=670.1.2.3 LineCode=mtx601 Length=667  units=ft
New Line.670671 Phases=3 Bus1=670.1.2.3 Bus2=671.1.2.3 LineCode=mtx601 Length=1333 units=ft
New Line.671680 Phases=3 Bus1=671.1.2.3 Bus2=680.1.2.3 LineCode=mtx601 Length=1000 units=ft
New Line.632633 Phases=3 Bus1=632.1.2.3 Bus2=633.1.2.3 LineCode=mtx602 Length=500  units=ft
New Line.632645 Phases=2 Bus1=632.3.2   Bus2=645.3.2   LineCode=mtx603 Length=500  units=ft
New Line.645646 Phases=2 Bus1=645.3.2   Bus2=646.3.2   LineCode=mtx603 Length=300  units=ft
New Line.692675 Phases=3 Bus1=671.1.2.3 Bus2=675.1.2.3 LineCode=mtx606 Length=500  units=ft
New Line.671684 Phases=2 Bus1=671.1.3   Bus2=684.1.3   LineCode=mtx604 Length=300  units=ft
New Line.684611 Phases=1 Bus1=684.3     Bus2=611.3     LineCode=mtx605 Length=300  units=ft
New Line.684652 Phases=1 Bus1=684.1     Bus2=652.1     LineCode=mtx607 Length=800  units=ft

Set Voltagebases=[115, 4.16, .48]
calcv
Solve
